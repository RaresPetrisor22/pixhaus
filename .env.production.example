# Production template. Copy to .env ON THE SERVER and fill in.
#
# Three kinds of value here, and it is worth knowing which is which:
#
#   GENERATE   a secret you create and never reuse. Every one of them:
#                node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   DASHBOARD  copied out of Cloudflare or Resend
#   MATCH DNS  has to agree with the A record you created
#
# See docs/deployment.md.

# ---- Which compose files ----------------------------------------------------

# No dev overlay: no MinIO, no Mailpit. The prod overlay adds Caddy.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- The domain -------------------------------------------------------------

# MATCH DNS. Caddy requests a certificate for exactly this name, and Let's
# Encrypt has to be able to reach it, so the A record must resolve first.
DOMAIN=pixhaus.example.com

# MATCH DNS. Every verification link and every magic link is built from this,
# so it must be the https origin — not a bind address, not an IP.
APP_URL=https://pixhaus.example.com

# ---- Postgres ---------------------------------------------------------------
#
# GENERATE both. These are baked into the roles by
# docker/postgres/init/01-create-app-role.sh, which runs ONCE against an empty
# data volume. Changing them later needs `docker compose down -v` or an
# ALTER ROLE by hand.

POSTGRES_DB=pixhaus
POSTGRES_USER=pixhaus_owner
POSTGRES_PASSWORD=

APP_DB_USER=pixhaus_app
APP_DB_PASSWORD=

# Only tooling run from the shell reads these; the containers build their own
# connection strings using `postgres` as the host.
DATABASE_URL=postgresql://pixhaus_app:CHANGEME@localhost:5432/pixhaus
MIGRATION_DATABASE_URL=postgresql://pixhaus_owner:CHANGEME@localhost:5432/pixhaus

# ---- Redis ------------------------------------------------------------------

# GENERATE.
REDIS_PASSWORD=

# ---- Object storage — Cloudflare R2 ------------------------------------------
#
# DASHBOARD. The endpoint is your account's S3 API URL; the keys come from an
# R2 API token scoped to this one bucket.
#
# Both endpoints are the same value in production, and that is the normal case —
# the split exists only because in development the API reaches MinIO at
# `minio:9000` while the browser reaches it at `localhost:9000`.
#
# The bucket needs a CORS rule allowing PUT and GET from APP_URL with `etag`
# exposed, or every browser upload fails. See docs/deployment.md.

STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=pixhaus
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

UPLOAD_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=104857600

# ---- Email — Resend ----------------------------------------------------------
#
# DASHBOARD. The from address has to be on a domain you verified with them, or
# delivery silently goes to spam.

SMTP_URL=smtp://resend:<api-key>@smtp.resend.com:587
SMTP_FROM=Pixhaus <no-reply@pixhaus.example.com>

# ---- Sessions and client tokens ----------------------------------------------

SESSION_TTL_HOURS=336
EMAIL_VERIFICATION_TTL_HOURS=24

# GENERATE. Rotating this invalidates every outstanding client token at once,
# which is the emergency brake per-grant revocation is not.
CLIENT_TOKEN_SECRET=

CLIENT_TOKEN_TTL_SECONDS=3600
CLIENT_URL_TTL_SECONDS=5400

# ---- Registration ------------------------------------------------------------
#
# GENERATE, and set it. Unset means anyone can create a studio and upload to
# your bucket.
REGISTRATION_INVITE_CODE=

# ---- Worker ------------------------------------------------------------------

# libvips is pinned to one thread per image, so this is very nearly the number
# of originals held in memory at once. Raising it past 4 also needs
# UV_THREADPOOL_SIZE raised to match.
WORKER_CONCURRENCY=2

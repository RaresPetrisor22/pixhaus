{
  "name": "@pixhaus/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema, migrations, and the migration runner",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node src/migrate.ts up",
    "migrate:status": "node src/migrate.ts status",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}

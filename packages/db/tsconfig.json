{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,

    // Node 22.18+/24 strips types at run time instead of compiling. These two
    // keep us inside the subset it can strip: no enums, no namespaces, no
    // parameter properties, and every type-only import spelled `import type`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}

# ---- Which compose files ----------------------------------------------------

# The base file is production-shaped. This adds MinIO and Mailpit, so a plain
# `docker compose up` gets the full development stack with no extra flags.
#
# COMPOSE_PATH_SEPARATOR is set explicitly because compose defaults it to `;` on
# Windows and `:` everywhere else, and this file is shared by both.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---- Postgres ---------------------------------------------------------------

POSTGRES_DB=pixhaus
POSTGRES_USER=pixhaus_owner
POSTGRES_PASSWORD=dev_owner_password

POSTGRES_PORT=5432

# Non-owner role. Owns no tables, so it IS subject to row-level security —
# the API and worker connect as this role, never as POSTGRES_USER.
APP_DB_USER=pixhaus_app
APP_DB_PASSWORD=dev_app_password

# Two connection strings, two roles.
#
#   DATABASE_URL            the app role. Owns nothing, so row-level security
#                           applies. Everything at runtime uses this.
#   MIGRATION_DATABASE_URL  the owner role. Creates the tables -- which is what
#                           makes the app role subject to their policies -- and
#                           bypasses RLS. Only the migration runner uses this.
#
# Host is `localhost` because you run migrations from your shell; inside the
# compose network it would be `postgres`.
DATABASE_URL=postgresql://pixhaus_app:dev_app_password@localhost:5432/pixhaus
MIGRATION_DATABASE_URL=postgresql://pixhaus_owner:dev_owner_password@localhost:5432/pixhaus

# ---- API ----------------------------------------------------------------

# Host port for the API. Inside the compose network it always listens on 3000;
# the container builds its own DATABASE_URL from the parts above, using
# `postgres` as the host rather than localhost.
API_PORT=3000

# The public origin, used to build the links that go out in email. Not the
# bind address -- this is what has to work when pasted into a browser.
APP_URL=http://localhost:3000

# How long a session cookie stays valid, and how long a verification link does.
SESSION_TTL_HOURS=336
EMAIL_VERIFICATION_TTL_HOURS=24

# ---- Redis --------------------------------------------------------------

REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password

# `localhost` for host-run tooling; compose overrides the host with `redis`.
# The empty username before the colon is deliberate — Redis AUTH with only a
# password is `redis://:password@host:port`.
REDIS_URL=redis://:dev_redis_password@localhost:6379

# ---- Object storage (S3-compatible; MinIO here, R2/B2/Wasabi in prod) ---


STORAGE_ENDPOINT=http://localhost:9000

# What gets signed into presigned URLs — the origin the BROWSER uses. SigV4
# signs the Host header, so a URL signed for one origin cannot be re-pointed at
# another. In production this equals STORAGE_ENDPOINT; locally they differ
# whenever the API runs inside compose and the browser does not.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

STORAGE_REGION=us-east-1
STORAGE_BUCKET=pixhaus
STORAGE_ACCESS_KEY=pixhaus_dev_access_key
STORAGE_SECRET_KEY=pixhaus_dev_secret_key
STORAGE_FORCE_PATH_STYLE=true

# How long a presigned upload URL lives, and the size ceiling enforced at mint
# time and again at finalize.
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=104857600

# ---- Client share links -------------------------------------------------

# Signs the short-lived token a client holds. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLIENT_TOKEN_SECRET=dev_client_token_secret_change_me_32chars

# Token lifetime, which is also how long a revoked client keeps working.
# The URL TTL must be at least the token TTL.
CLIENT_TOKEN_TTL_SECONDS=3600
CLIENT_URL_TTL_SECONDS=5400

# Set this and registration requires a matching `inviteCode`. Left unset,
# anyone can sign up — which is what you want locally.
# REGISTRATION_INVITE_CODE=

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Worker -------------------------------------------------------------

# How many renditions jobs run at once. libvips is pinned to one thread per
# image, so this is very nearly the number of originals held in memory at a
# time -- raise it for more cores, lower it for a smaller container.
WORKER_CONCURRENCY=2

# ---- Mail (Mailpit locally — catches everything, sends nothing) ---------

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# `localhost` for the same reason as DATABASE_URL above: this file is read when
# you run the API from your shell. Compose overrides it with `mailpit`.
SMTP_URL=smtp://localhost:1025
SMTP_FROM=Pixhaus <no-reply@pixhaus.local>

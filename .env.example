# ---- Postgres ---------------------------------------------------------------

POSTGRES_DB=pixhaus
POSTGRES_USER=pixhaus_owner
POSTGRES_PASSWORD=dev_owner_password

POSTGRES_PORT=5432

# Non-owner role. Owns no tables, so it IS subject to row-level security —
# the API and worker connect as this role, never as POSTGRES_USER.
APP_DB_USER=pixhaus_app
APP_DB_PASSWORD=dev_app_password

# ---- Redis --------------------------------------------------------------

REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password

# ---- Object storage (S3-compatible; MinIO here, R2/B2/Wasabi in prod) ---

STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pixhaus
STORAGE_ACCESS_KEY=pixhaus_dev_access_key
STORAGE_SECRET_KEY=pixhaus_dev_secret_key
STORAGE_FORCE_PATH_STYLE=true

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Mail (Mailpit locally — catches everything, sends nothing) ---------

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://mailpit:1025

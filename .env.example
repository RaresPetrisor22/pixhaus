# ---- Postgres ---------------------------------------------------------------

POSTGRES_DB=pixhaus
POSTGRES_USER=pixhaus_owner
POSTGRES_PASSWORD=dev_owner_password

POSTGRES_PORT=5432

# Non-owner role. Owns no tables, so it IS subject to row-level security —
# the API and worker connect as this role, never as POSTGRES_USER.
APP_DB_USER=pixhaus_app
APP_DB_PASSWORD=dev_app_password
